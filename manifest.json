{
  "manifest_version": 3,
  "name": "浏览器伪装大师",
  "version": "1.6.0",
  "description": "按域名配置时区、语言、Intl、字体探测、UA、WebRTC 与模拟位置。",
  "minimum_chrome_version": "135",
  "permissions": ["storage", "userScripts", "declarativeNetRequestWithHostAccess", "activeTab"],
  "optional_permissions": ["browsingData", "history", "cookies"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": { "default_title": "浏览器伪装大师", "default_popup": "popup.html", "default_icon": {"16":"icons/icon16.png","32":"icons/icon32.png"} },
  "options_page": "options.html"
}
